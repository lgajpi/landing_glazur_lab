# Продакшн на Termux (Android). Caddy отдаёт статику по HTTPS (сертификат авто)
# и проксирует /api/* на Go-бэкенд заявок, висящий рядом на 127.0.0.1:8085.
#
#   браузер ─HTTPS→ Caddy :443 ─┬─ статика (index.html, css, js, images)
#                               └─ /api/* → Go-бэк 127.0.0.1:8085 → MAX Bot API
#
# ВАЖНО:
#   1. Замени домен ниже на свой (тот, что уже работал с сертификатом).
#   2. Порты 80/443 в Termux требуют ROOT — запускать от root, как раньше:
#         sudo caddy run --config ~/landing_glazur_lab/Caddyfile.prod
#      (или через tsu). Без root порты <1024 занять нельзя → permission denied.
#   3. Go-бэк должен быть запущен на 8085 (иначе /api отдаёт 502):
#         cd ~/landing_glazur_lab/backend && go run .

glazur-lab.ru, www.glazur-lab.ru {
	encode gzip

	# корень со статикой лендинга — путь в файловой системе Termux
	root * /data/data/com.termux/files/home/landing_glazur_lab

	# заявки — на Go-бэк (тот же origin, CORS не нужен)
	handle /api/* {
		reverse_proxy 127.0.0.1:8085
	}

	# всё остальное — статика
	handle {
		file_server
	}

	# необязательно: заголовки безопасности
	header {
		-Server
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
	}
}
