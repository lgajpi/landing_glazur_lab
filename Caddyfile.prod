# Продакшн на Termux (Android) за роутером с проброс-портами.
# Роутер форвардит внешние порты на устройство: 80 → 8080, 443 → 8443.
# Поэтому Caddy слушает НЕпривилегированные 8080/8443 — root НЕ нужен.
#
#   интернет :80/:443 ─(роутер)→ устройство :8080/:8443 ─ Caddy ─┬─ статика
#                                                                └─ /api/* → Go :8085
#
# ВАЖНО:
#   1. Замени домен ниже на свой (тот, что уже работал с сертификатом).
#   2. Запуск БЕЗ root:
#         caddy run --config ~/landing_glazur_lab/Caddyfile.prod
#   3. Go-бэк должен висеть на 8085 (иначе /api отдаёт 502):
#         cd ~/landing_glazur_lab/backend && go run .

{
	# Caddy за NAT: слушаем непривилегированные порты, роутер форвардит на них
	# внешние 80/443. ACME-проверка Let's Encrypt проходит через проброс.
	http_port 8080
	https_port 8443
}

glazur-lab.ru, www.glazur-lab.ru {
	encode gzip

	# корень со статикой лендинга — путь в файловой системе Termux
	root * /data/data/com.termux/files/home/landing_glazur_lab

	# заявки — на Go-бэк (тот же origin, CORS не нужен)
	handle /api/* {
		reverse_proxy 127.0.0.1:8085
	}

	# всё остальное — статика
	handle {
		file_server
	}

	# необязательно: заголовки безопасности
	header {
		-Server
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
	}
}
