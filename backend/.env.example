# Токен MAX-бота (выдаётся @MasterBot в MAX при создании бота). Секрет!
MAX_BOT_TOKEN=

# ID группового чата, куда бот кладёт заявки.
# Бот должен быть добавлен в этот чат. Узнать id можно из апдейта
# (бот получает chat_id в recipient), либо через GET /chats.
MAX_CHAT_ID=-77275498297445

# Порт HTTP-сервера (необязательно, по умолчанию 8080).
# Фронт (script.js → ORDER_ENDPOINT) сейчас ждёт бэк на 8085.
PORT=8085

# Разрешённый источник для CORS — домен лендинга в проде.
# Например: https://xn--80ajbtmc7ae.xn--p1ai
# По умолчанию * (разрешить всем) — для локальной разработки.
ALLOWED_ORIGIN=*

# Серверный (secret) ключ Yandex SmartCaptcha. Секрет! В git не коммитить.
# Клиентский ключ (ysc1_...) живёт во фронте (script.js), сюда — только secret.
# Если пусто — проверка капчи выключена (удобно для локальной разработки).
SMARTCAPTCHA_SERVER_KEY=
